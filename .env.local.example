# Copy to .env.local and fill in from your Supabase project settings (API section).
# No service-role key is needed anywhere: RLS plus security-definer functions
# cover every write in this app.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Live binder updates. Set to 0 to fall back to a 5s poll — useful if you expect
# more than ~200 simultaneous viewers, which is the Supabase free-tier ceiling
# on Realtime peak connections.
NEXT_PUBLIC_REALTIME=1

# Used to build the OAuth redirect for local dev. In production Vercel provides
# VERCEL_URL automatically and this can be left unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
